#!/bin/sh
# Entry point of scrum-harness. The hooks run in every session on this Mac. On a heavily loaded Mac,
# to avoid starting node on every tool call, dispatch here by the session's role (the record that src/team/identity.ts
# writes to ~/.claude/scrum/identity/<session_id>.json).
#   Outside the team: do nothing
#   Member: only write the turn-boundary heartbeat in the background. Do nothing on tool calls. Start node only when dispatch is enabled,
#         for the Stop and SessionStart watch (waiting for the moment the next work is handed over once the member is free)
#   Liaison: start node only when alerts is enabled, for the Stop and SessionStart watch (waiting for the notification text that stall detection decided).
#         Do nothing on other hooks
#   TechLead: start node only after board-related commands and when the watch process has placed a marker (notify/pending)
DIR=$(cd "$(dirname "$0")/.." && pwd)
STATE=${SCRUM_STATE_DIR:-$HOME/.claude/scrum}
CLI="$DIR/src/cli.ts"
# Command patterns that start node. node writes them from the script names in the config (writeShellPatterns in src/cli-commands.ts).
# While they are not yet written, only gh commands are checked.
POST_PATTERN=$(sed -n 1p "$STATE/cache/shell-patterns" 2>/dev/null)
PRE_PATTERN=$(sed -n 2p "$STATE/cache/shell-patterns" 2>/dev/null)
[ -n "$POST_PATTERN" ] || POST_PATTERN='gh pr merge|gh issue close|gh project|ProjectV2'

if [ "$1" != hook ] && [ "$1" != watch ] && [ "$1" != statusline ]; then
  exec node --no-warnings "$CLI" "$@"
fi

input=$(cat)
event=${2:-$1}

run() { printf '%s' "$input" | node --no-warnings "$CLI" "$@"; }
run_detached() { (printf '%s' "$input" | node --no-warnings "$CLI" "$@" >/dev/null 2>&1 &); }

# The write guard applies regardless of role. It is checked only when a script that changes Status is called.
if [ "$event" = PreToolUse ]; then
  if [ -n "$PRE_PATTERN" ] && printf '%s' "$input" | grep -Eq "$PRE_PATTERN"; then
    run "$@"
  fi
  exit 0
fi

role=""
if [ -n "$SCRUM_NAME" ]; then
  role=env
else
  sid=$(printf '%s' "$input" | sed -n 's/.*"session_id" *: *"\([^"]*\)".*/\1/p' | head -n 1)
  cache="$STATE/identity/$sid.json"
  [ -f "$cache" ] && role=$(sed -n 's/.*"role": "\([a-z]*\)".*/\1/p' "$cache")
  # Names can change later, so the "outside the team" verdict is re-fetched after 1 hour
  if [ "$role" = none ] && [ -z "$(find "$cache" -mmin -60 2>/dev/null)" ]; then role=""; fi
fi

# The statusline is shown only in the TechLead session
if [ "$event" = statusline ]; then
  [ "$role" = techlead ] || [ "$role" = env ] && run "$@"
  exit 0
fi

# While a team session is working, append one activity line to events.jsonl once every 10 minutes. This does not start node.
# If only watch wrote the activity record, then when the team worked while watch was stopped there would be no record, and the checkpoints in that span would be excluded from effort as checkpoints when all sessions were
# stalled.
# Append only on PostToolUse. A tool result appears only after the API has responded, so it is a mark of work. UserPromptSubmit, SessionStart, and
# Stop still pass during the weekly limit (a scheduled run's input passes the hook, and only after that does the API return the limit response). Appending on them would write
# records even while all sessions were stalled, and the stall could not be read.
# To avoid starting a process on the turns that do not write (most calls), use only shell builtins: take the mtime of the mark activity-due as
# the "next time to write" and compare it with -nt against the mark activity-now for the current time (: > sets its mtime to now). If the write fails, the dispatch does not change.
record_activity() {
  due="$STATE/cache/activity-due"
  marker="$STATE/cache/activity-now"
  [ -d "$STATE/log" ] || return 0
  : >"$marker" 2>/dev/null || return 0
  [ "$due" -nt "$marker" ] && return 0
  next=$(date -v+10M +%Y%m%d%H%M.%S 2>/dev/null || date -d '+10 minutes' +%Y%m%d%H%M.%S 2>/dev/null) || return 0
  touch -t "$next" "$due" 2>/dev/null || return 0
  printf '{"at":"%s","type":"activity","role":"%s"}\n' "$(date -u +%Y-%m-%dT%H:%M:%S.000Z)" "$role" >>"$STATE/log/events.jsonl" 2>/dev/null
  return 0
}
case "$role" in
  none | "") ;;
  *)
    case "$event" in
      PostToolUse) record_activity ;;
      *) ;;
    esac
    ;;
esac

case "$role" in
  none)
    exit 0
    ;;
  member)
    case "$event" in
      PostToolUse) exit 0 ;;
      watch)
        # Start the watch only when line 3 of shell-patterns (written by node from the config) is 1
        if [ "$(sed -n 3p "$STATE/cache/shell-patterns" 2>/dev/null)" = 1 ]; then
          run "$@"
          exit $?
        fi
        exit 0
        ;;
      *) run_detached "$@"; exit 0 ;;
    esac
    ;;
  liaison)
    if [ "$event" = watch ] && [ "$(sed -n 4p "$STATE/cache/shell-patterns" 2>/dev/null)" = 1 ]; then
      run "$@"
      exit $?
    fi
    exit 0
    ;;
  techlead)
    if [ "$event" = PostToolUse ]; then
      if printf '%s' "$input" | grep -Eq "$POST_PATTERN" || [ -e "$STATE/notify/pending" ]; then
        run "$@"
      fi
      exit 0
    fi
    run "$@"
    exit $?
    ;;
  *)
    # The role is unknown (no record, or specified by SCRUM_NAME): node looks it up and writes the record
    run "$@"
    exit $?
    ;;
esac
