<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>local.scrum-harness.alerts</string>
	<key>ProgramArguments</key>
	<array>
		<string>/opt/scrum-harness/bin/scrum</string>
		<string>alerts</string>
	</array>
	<key>WorkingDirectory</key>
	<string>/opt/scrum-harness</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/usr/local/bin:/usr/bin:/bin</string>
	</dict>
	<key>StartInterval</key>
	<integer>300</integer>
	<key>RunAtLoad</key>
	<false/>
	<key>Umask</key>
	<integer>63</integer>
	<key>ProcessType</key>
	<string>Background</string>
	<key>Nice</key>
	<integer>10</integer>
	<key>LowPriorityIO</key>
	<true/>
	<key>StandardOutPath</key>
	<string>/home/alice/.claude/scrum/log/alerts-launchd.log</string>
	<key>StandardErrorPath</key>
	<string>/home/alice/.claude/scrum/log/alerts-launchd.log</string>
</dict>
</plist>
